# Internet Archive / Wayback access
IA_ACCESS_KEY=
IA_SECRET_KEY=

# Crawl defaults
CRAWL_CONCURRENCY=4
CRAWL_TIMEOUT_SECONDS=30
CRAWL_PER_DOMAIN_LIMIT=50

# Snapshot selection policy: closest_before | closest_after | closest
SNAPSHOT_POLICY=closest_before

# Optional: Playwright for computed CSS extraction
ENABLE_COMPUTED_STYLES=false
